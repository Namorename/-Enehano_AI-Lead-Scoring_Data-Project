# ── Salesforce credentials ────────────────────────────────────────────────────
# Get security token from Salesforce: Settings > My Personal Info > Reset Security Token
SF_USERNAME=your.name@enehano.com
SF_PASSWORD=your_salesforce_password
SF_SECURITY_TOKEN=your_security_token_here
SF_DOMAIN=login          # "login" for production, "test" for sandbox

# ── API configuration ─────────────────────────────────────────────────────────
API_URL=http://localhost:8000
BATCH_SIZE=200           # leads per /score/batch call (max 500)

# ── Feedback loop ─────────────────────────────────────────────────────────────
DAYS_BACK_OUTCOMES=7           # how many days of closes to pull from SF each night
RETRAIN_THRESHOLD=200          # real outcomes needed before auto-retrain triggers
MIN_DAYS_BETWEEN_RETRAINS=7    # minimum days between retrain runs

# ── Model training ────────────────────────────────────────────────────────────
# Set to 1 before training on real CRM data to exclude leakage proxy features.
# Must be 1 for any production retrain once real Closed_Won history is available.
EXCLUDE_STATUS_PROXIES=0
RUN_OPTUNA=0             # set to 1 to run hyperparameter search (slow, ~1 hour)
OPTUNA_TRIALS=50

# ── Alerting (optional) ───────────────────────────────────────────────────────
# Create an Incoming Webhook in Slack: api.slack.com/messaging/webhooks
SLACK_WEBHOOK_URL=
