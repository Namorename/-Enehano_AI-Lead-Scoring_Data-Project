# Copy to ".env" and fill in. Used by src/sf_sync.py (and the API key guard).
# Never commit the real .env - it is covered by .gitignore.

# ── Salesforce credentials (Developer Edition works) ──────────────────────────
SF_USER=you@example.com
SF_PASS=your_password
SF_TOKEN=your_security_token # Setup -> Reset My Security Token (emailed to you)
SF_DOMAIN=login # 'login' for production/Developer Edition, 'test' for a sandbox

# ── Field mapping (optional) ──────────────────────────────────────────────────
SF_ICO_FIELD=ICO__c # Lead field that stores the company IČO
# Comma-separated Lead fields to feed the model (must be valid EnrichLeadInput names).
# Leave empty for a fresh org; populate once the behavioural custom fields exist:
SF_BEHAVIORAL_FIELDS=

# ── Scoring API auth (only needed when exposing the FastAPI service publicly) ──
SCORING_API_KEY=
